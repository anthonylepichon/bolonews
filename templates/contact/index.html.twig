{% extends 'base.html.twig' %}

{% block title %}Contact - Bolonews{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>Contact</h1>

            <p>
                Une question sur Bolonews ?
                Écrivez-nous un message.
            </p>
        </header>

        <section aria-labelledby="contact-form-title">
            <h2 id="contact-form-title">
                Envoyer un message
            </h2>

            <form aria-describedby="contact-scope">
                <div>
                    <label for="contact-pseudo">
                        Pseudonyme
                    </label>

                    <input
                        type="text"
                        id="contact-pseudo"
                        name="pseudo"
                        autocomplete="nickname"
                        placeholder="Votre pseudonyme"
                    >
                </div>

                <div>
                    <label for="contact-email">
                        Adresse e-mail
                    </label>

                    <input
                        type="email"
                        id="contact-email"
                        name="email"
                        autocomplete="email"
                        placeholder="nom@exemple.fr"
                    >
                </div>

                <div>
                    <label for="contact-subject">
                        Sujet
                    </label>

                    <input
                        type="text"
                        id="contact-subject"
                        name="subject"
                        placeholder="Objet de votre message"
                    >
                </div>

                <div>
                    <label for="contact-message">
                        Message
                    </label>

                    <textarea
                        id="contact-message"
                        name="message"
                        rows="8"
                        placeholder="Écrivez votre message…"
                    ></textarea>
                </div>

                <button
                    type="button"
                    disabled
                >
                    Envoyer le message
                </button>

                <p id="contact-scope">
                    L’envoi du formulaire n’est pas activé dans
                    le périmètre fonctionnel de cet exercice.
                </p>
            </form>
        </section>
    </main>
{% endblock %}
