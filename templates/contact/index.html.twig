{# Présentation : vue du formulaire de contact prévu par la maquette.
   Rôle : présenter les champs sans traitement serveur, conformément au périmètre retenu. #}
{% extends 'base.html.twig' %}

{% block title %}Contact - Bolonews{% endblock %}

{% block body %}
    {# Zone : contenu principal de la page de contact. #}
    <main>
        {# Zone : en-tête éditorial de la page. #}
        <header class="home-masthead">
            <h1 class="home-masthead__title">Bolonews</h1>
            <p class="home-masthead__subtitle">
                Une question sur Bolonews ? Envoyez-nous un message.
            </p>
        </header>

        {# Zone : carte contenant les informations et les champs de contact. #}
        <div class="container form-page-content">
            <section class="form-card form-card--contact" aria-labelledby="contact-title">
                <h2 id="contact-title">Contact</h2>
                <p class="form-card__intro">
                    Complétez ce formulaire pour préparer votre message.
                </p>

                {# Zone : formulaire de démonstration. Sans action ni méthode POST, aucune donnée
                   n'est envoyée car le traitement contact est hors périmètre. #}
                <form class="app-form" id="contact-form" aria-describedby="contact-scope">
                    <div class="mb-4">
                        <label class="form-label" for="contact-pseudo">Nom d’utilisateur</label>
                        <input class="form-control" type="text" id="contact-pseudo" name="pseudo" autocomplete="nickname" placeholder="Votre pseudonyme">
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="contact-email">Adresse e-mail</label>
                        <input class="form-control" type="email" id="contact-email" name="email" autocomplete="email" placeholder="nom@exemple.fr">
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="contact-subject">Sujet</label>
                        <input class="form-control" type="text" id="contact-subject" name="subject" placeholder="Objet de votre message">
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="contact-message">Message</label>
                        <textarea class="form-control" id="contact-message" name="message" rows="5" placeholder="Écrivez votre message…"></textarea>
                    </div>

                    {# type=button empêche précisément une soumission accidentelle. #}
                    <button class="btn btn-primary" type="button">Envoyer</button>
                    <p class="visually-hidden" id="contact-scope">
                        L’envoi n’est pas activé dans le périmètre de l’exercice.
                    </p>
                </form>

                {# Zone : actions secondaires de nettoyage et de retour. #}
                <div class="form-actions form-actions--below-card">
                    {# Le bouton reset cible le formulaire grâce à son attribut form,
                       même s'il est placé visuellement en dehors de celui-ci. #}
                    <button class="btn btn-outline-primary" type="reset" form="contact-form">
                        Effacer le formulaire
                    </button>
                    <a class="btn btn-outline-primary" href="{{ path('app_home') }}">Retour à l’accueil</a>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
