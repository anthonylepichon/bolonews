{% extends 'base.html.twig' %}

{% block title %}Inscription - Bolonews{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>Créer mon compte</h1>
            <p>
                Rejoignez Bolonews pour publier, commenter et aimer
                des articles.
            </p>
        </header>

        <section aria-labelledby="registration-title">
            <h2 id="registration-title">Mes informations</h2>

            {{ form_start(registrationForm) }}

                {{ form_errors(registrationForm) }}

                {{ form_row(registrationForm.pseudo, {
                    label: 'Pseudonyme',
                    attr: {
                        placeholder: 'Votre pseudonyme'
                    }
                }) }}

                {{ form_row(registrationForm.avatar, {
                    label: 'Avatar ou image de profil',
                    help: 'Image JPG ou PNG, 2 Mo maximum. Sans image, les initiales du pseudonyme seront utilisées.'
                }) }}

                {{ form_row(registrationForm.email, {
                    label: 'Adresse e-mail',
                    attr: {
                        placeholder: 'nom@exemple.fr'
                    }
                }) }}

                {{ form_errors(registrationForm.plainPassword) }}

                {{ form_row(
                    registrationForm.plainPassword.first,
                    {
                        label: 'Mot de passe'
                    }
                ) }}

                {{ form_row(
                    registrationForm.plainPassword.second,
                    {
                        label: 'Confirmation du mot de passe'
                    }
                ) }}

                {{ form_row(registrationForm.agreeTerms, {
                    label: 'J’accepte les conditions d’utilisation et la politique de confidentialité.'
                }) }}

                <button type="submit">
                    Créer mon compte
                </button>

            {{ form_end(registrationForm) }}

            <p>
                Déjà inscrit ?
                <a href="{{ path('app_login') }}">
                    Se connecter
                </a>
            </p>
        </section>
    </main>
{% endblock %}
