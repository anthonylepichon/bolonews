{# Présentation : catalogue public des articles.
   Rôle : afficher la recherche, les catégories, les filtres actifs et la liste actualisable en AJAX. #}
{% extends 'base.html.twig' %}

{% block title %}Articles - Bolonews{% endblock %}

{% block body %}
    {# Zone : contenu principal du catalogue des articles. #}
    <main class="articles-page">
        {# Zone : en-tête éditorial commun aux pages publiques. #}
        <header class="home-masthead">
            <div class="container">
                <h1 class="home-masthead__title">Bolonews</h1>
                <p class="home-masthead__subtitle">
                    L’actualité qui se déguste, à lire chaque jour.
                </p>
            </div>
        </header>

        {# Zone : panneau fixe regroupant la recherche et les filtres. #}
        <section
            class="article-search-panel"
            aria-labelledby="article-search-title"
        >
            <h2
                class="visually-hidden"
                id="article-search-title"
            >
                Rechercher et filtrer les articles
            </h2>

            {# Zone : recherche textuelle déclenchée par la loupe. #}
            <form
                class="article-search-form"
                action="{{ path('app_article_index') }}"
                method="get"
                role="search"
                data-article-search-form
            >
                {# Les attributs data-* sont des points d'accroche pour
                   article-search.js ; le formulaire GET reste utilisable sans JS. #}
                <label
                    class="visually-hidden"
                    for="article-search"
                >
                    Rechercher un article
                </label>

                <div class="article-search-control">
                    <input
                        type="search"
                        id="article-search"
                        name="recherche"
                        value="{{ search }}"
                        placeholder="Rechercher"
                    >

                    {% if selectedCategoryId %}
                        <input
                            type="hidden"
                            name="categorie"
                            value="{{ selectedCategoryId }}"
                        >
                    {% endif %}

                    <a
                        class="article-search-control__reset"
                        href="{{ path('app_article_index') }}"
                        data-search-reset
                        aria-label="Réinitialiser la recherche et les filtres"
                        {% if
                            search is empty
                            and selectedCategoryId is null
                        %}
                            hidden
                        {% endif %}
                    >
                        <img
                            src="{{ asset('images/icons/x.svg') }}"
                            alt=""
                            aria-hidden="true"
                        >
                    </a>

                    <button
                        class="article-search-control__submit"
                        type="submit"
                        aria-label="Lancer la recherche"
                    >
                        <img
                            src="{{ asset('images/icons/search.svg') }}"
                            alt=""
                            aria-hidden="true"
                        >
                    </button>
                </div>
            </form>

            {# Zone : navigation entre les catégories d'articles. #}
            <nav
                class="article-filter-nav"
                aria-label="Filtrer par catégorie"
            >
                <ul class="article-filters">
                    <li>
                        <a
                            href="{{ path(
                                'app_article_index',
                                search is not empty
                                    ? {recherche: search}
                                    : {}
                            ) }}"
                            data-article-filter-link
                            {# L'identifiant vide représente « Toutes » dans le
                               module JS et supprime le paramètre categorie. #}
                            data-category-id=""
                            data-category-label="Toutes"
                            {% if selectedCategoryId is null %}
                                aria-current="true"
                            {% endif %}
                        >
                            Toutes
                        </a>
                    </li>

                    {% for category in categories %}
                        <li>
                            <a
                                href="{{ path(
                                    'app_article_index',
                                    search is not empty
                                        ? {
                                            recherche: search,
                                            categorie: category.id
                                        }
                                        : {categorie: category.id}
                                ) }}"
                                data-article-filter-link
                                data-category-id="{{ category.id }}"
                                data-category-label="{{ category.label }}"
                                {% if selectedCategoryId == category.id %}
                                    aria-current="true"
                                {% endif %}
                            >
                                {{ category.label }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            {# Zone : récapitulatif des critères actuellement appliqués. #}
            <div
                class="active-article-filters"
                data-active-filters
                {% if
                    search is empty
                    and selectedCategoryId is null
                %}
                    hidden
                {% endif %}
            >
                {# Ce résumé est rendu côté serveur au chargement, puis reconstruit
                   côté client après chaque recherche AJAX. #}
                <p>Filtres actifs :</p>

                <ul data-active-filter-list>
                    {% if search is not empty %}
                        <li>Recherche : « {{ search }} »</li>
                    {% endif %}

                    {% if selectedCategoryId %}
                        {% for category in categories %}
                            {% if category.id == selectedCategoryId %}
                                <li>Catégorie : {{ category.label }}</li>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        </section>

        {# Zone : titre et résultats du catalogue, remplaçables par AJAX. #}
        <section
            class="container articles-content"
            aria-labelledby="articles-title"
        >
            <h2
                class="articles-content__title"
                id="articles-title"
                data-articles-title
            >
                {% if search is not empty or selectedCategoryId %}
                    Résultats de recherche
                {% else %}
                    Tous les articles
                {% endif %}
            </h2>

            <div
                data-articles-results
                aria-live="polite"
            >
                {# La même partial est utilisée ici et par la réponse AJAX : cela
                   évite de maintenir deux versions HTML de la liste. #}
                {{ include(
                    'article/_list.html.twig',
                    {articles: articles}
                ) }}
            </div>
        </section>
    </main>
{% endblock %}
