{% extends 'base.html.twig' %}

{% block title %}Connexion - Bolonews{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>Se connecter</h1>
            <p>Accédez à votre espace Bolonews.</p>
        </header>

        {% if app.user %}
            <section>
                <h2>Vous êtes déjà connecté</h2>

                <p>
                    Votre compte est actuellement connecté avec l’adresse
                    {{ app.user.userIdentifier }}.
                </p>

                <a href="{{ path('app_home') }}">
                    Retour à l’accueil
                </a>

                <a href="{{ path('app_logout') }}">
                    Me déconnecter
                </a>
            </section>
        {% else %}
            <section aria-labelledby="login-title">
                <h2 id="login-title">Connexion à votre compte</h2>

                {% if error %}
                    <div role="alert">
                        Adresse e-mail ou mot de passe incorrect.
                    </div>
                {% endif %}

                <form
                    action="{{ path('app_login') }}"
                    method="post"
                >
                    <div>
                        <label for="login-email">
                            Adresse e-mail
                        </label>

                        <input
                            type="email"
                            id="login-email"
                            name="_username"
                            value="{{ last_username }}"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </div>

                    <div>
                        <label for="login-password">
                            Mot de passe
                        </label>

                        <input
                            type="password"
                            id="login-password"
                            name="_password"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                    >

                    <button type="submit">
                        Se connecter
                    </button>
                </form>
                <p>
                    Vous n’avez pas encore de compte ?
                    <a href="{{ path('app_register') }}">
                        Créer un compte
                    </a>
                </p>
            </section>
        {% endif %}
    </main>
{% endblock %}
