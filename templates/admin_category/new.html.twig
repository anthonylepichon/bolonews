{# Présentation : page dédiée à l'ajout d'une catégorie.
   Rôle : proposer une alternative complète au formulaire intégré au tableau d'administration. #}
{% extends 'base.html.twig' %}

{% block title %}Ajouter une catégorie - Bolonews{% endblock %}

{% block body %}
    {# Zone : contenu principal de l'ajout d'une catégorie. #}
    <main>
        {# Zone : en-tête de la page dédiée. #}
        <header class="home-masthead">
            <h1 class="home-masthead__title">Bolonews</h1>
            <p class="home-masthead__subtitle">Ajoutez une catégorie pour classer les articles.</p>
        </header>

        {# Zone : carte contenant le formulaire mutualisé. #}
        <div class="container form-page-content">
            <section class="form-card" aria-labelledby="category-form-title">
                <h2 id="category-form-title">Nouvelle catégorie</h2>
                {{ include('admin_category/_form.html.twig', {button_label: 'Ajouter la catégorie'}) }}
                <a class="btn btn-outline-primary mt-3" href="{{ path('app_admin_category_index') }}">Annuler</a>
            </section>
        </div>
    </main>
{% endblock %}
