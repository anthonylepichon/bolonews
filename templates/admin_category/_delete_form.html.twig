{# Présentation : fragment Twig de suppression d'une catégorie.
   Rôle : proposer une confirmation sans JavaScript et expliquer un éventuel blocage métier. #}
{# Zone : panneau de confirmation repliable. #}
<details>
    <summary>Supprimer</summary>

    {% if category.articles is empty %}
        <p>
            Supprimer définitivement la catégorie
            « {{ category.label }} » ?
        </p>

        <p>Cette action est irréversible.</p>

        {# Zone : requête POST de suppression protégée par un jeton CSRF. #}
        <form
            method="post"
            action="{{ path(
                'app_admin_category_delete',
                {id: category.id}
            ) }}"
        >
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token(
                    'delete' ~ category.id
                ) }}"
            >

            <button class="btn btn-danger" type="submit">
                Supprimer la catégorie
            </button>
        </form>
    {% else %}
        {# Zone : explication du blocage lorsque des articles sont encore liés. #}
        <p>
            Cette catégorie ne peut pas être supprimée,
            car elle est utilisée par
            {{ category.articles|length }} article(s).
        </p>
    {% endif %}
</details>
