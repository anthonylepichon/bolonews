{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Bolonews{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>Gestion des utilisateurs</h1>
            <p>
                Recherchez, bannissez, réactivez ou supprimez un compte.
            </p>
        </header>

        <section aria-labelledby="user-search-title">
            <h2 id="user-search-title">
                Rechercher un utilisateur
            </h2>

            <form
                action="{{ path('app_admin_user_index') }}"
                method="get"
                role="search"
            >
                <label for="user-search">
                    Nom d’utilisateur ou adresse e-mail
                </label>

                <div>
                    <input
                        type="search"
                        id="user-search"
                        name="recherche"
                        value="{{ search }}"
                        placeholder="Pseudo ou adresse e-mail"
                    >

                    <button
                        type="submit"
                        aria-label="Lancer la recherche"
                    >
                        <span aria-hidden="true">🔍</span>
                    </button>

                    {% if search is not empty %}
                        <a
                            href="{{ path('app_admin_user_index') }}"
                            aria-label="Réinitialiser la recherche"
                        >
                            <span aria-hidden="true">×</span>
                        </a>
                    {% endif %}
                </div>
            </form>

            {% if search is not empty %}
                <p>
                    Résultats correspondant à
                    « {{ search }} »
                </p>
            {% endif %}
        </section>

        <section aria-labelledby="users-title">
            <h2 id="users-title">Comptes utilisateurs</h2>

            <table>
                <caption>
                    Liste des comptes Bolonews
                </caption>

                <thead>
                    <tr>
                        <th scope="col">Utilisateur</th>
                        <th scope="col">Adresse e-mail</th>
                        <th scope="col">Statut</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>
                                {% if user.avatarFilename %}
                                    <img
                                        src="{{ asset(
                                            'images/avatars/'
                                            ~ user.avatarFilename
                                        ) }}"
                                        alt="Avatar de {{ user.pseudo }}"
                                    >
                                {% else %}
                                    <span aria-hidden="true">
                                        {{ user.pseudo
                                            |slice(0, 2)
                                            |upper
                                        }}
                                    </span>
                                {% endif %}

                                {{ user.pseudo }}
                            </td>

                            <td>{{ user.email }}</td>

                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    Administrateur
                                {% elseif user.isBanned %}
                                    Compte banni
                                {% else %}
                                    Compte actif
                                {% endif %}
                            </td>

                            <td>
                                {% if 'ROLE_ADMIN' not in user.roles %}
                                    <form
                                        method="post"
                                        action="{{ path(
                                            'app_admin_user_toggle_ban',
                                            {id: user.id}
                                        ) }}"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token(
                                                'toggle-ban' ~ user.id
                                            ) }}"
                                        >

                                        <button type="submit">
                                            {{ user.isBanned
                                                ? 'Réactiver'
                                                : 'Bannir'
                                            }}
                                        </button>
                                    </form>

                                    <details>
                                        <summary>Supprimer</summary>

                                        <p>
                                            Supprimer définitivement
                                            le compte « {{ user.pseudo }} » ?
                                        </p>

                                        <p>
                                            Cette action est irréversible.
                                        </p>

                                        <form
                                            method="post"
                                            action="{{ path(
                                                'app_admin_user_delete',
                                                {id: user.id}
                                            ) }}"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token(
                                                    'delete-user' ~ user.id
                                                ) }}"
                                            >

                                            <button type="submit">
                                                Supprimer le compte
                                            </button>
                                        </form>
                                    </details>
                                {% else %}
                                    Actions protégées
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                Aucun utilisateur ne correspond
                                à cette recherche.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <a href="{{ path('app_admin') }}">
            Retour à l’espace administrateur
        </a>
    </main>
{% endblock %}
