{% extends 'base.html.twig' %}

{% block title %}Accueil - Bolonews{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>Bolonews</h1>
            <p>L’actualité qui se déguste, à lire chaque jour.</p>
        </header>

        {% if articles is not empty %}
            {% set featuredArticle = articles|first %}
            {% set latestArticles = articles|slice(1) %}

            <section>
                <h2>À la une</h2>

                <article>
                    <img
                        src="{{ asset('images/articles/' ~ featuredArticle.imageFilename) }}"
                        alt="Illustration de l’article {{ featuredArticle.title }}"
                    >

                    <p>{{ featuredArticle.category.label }}</p>
                    <h3>
                        <a href="{{ path('app_article_show', {id: featuredArticle.id}) }}">
                            {{ featuredArticle.title }}
                        </a>
                    </h3>
                    <p>{{ featuredArticle.chapeau }}</p>

                    <p>
                        {{ featuredArticle.author
                            ? featuredArticle.author.pseudo
                            : 'Auteur supprimé'
                        }}
                    </p>

                    <p>
                        Publié le
                        {{ featuredArticle.createdAt|date('d/m/Y à H:i') }}
                    </p>

                    <p>
                        {{ featuredArticle.comments|length }} commentaire(s) -
                        {{ featuredArticle.likes|length }} J’aime
                    </p>

                    <a href="{{ path('app_article_show', {
                        id: featuredArticle.id
                    }) }}">
                        Lire l’article
                    </a>
                </article>
            </section>

            <section>
                <h2>Dernières parutions</h2>

                {% for article in latestArticles %}
                    <article>
                        <img
                            src="{{ asset('images/articles/' ~ article.imageFilename) }}"
                            alt="Illustration de l’article {{ article.title }}"
                        >

                        <p>{{ article.category.label }}</p>
                        <h3>
                            <a href="{{ path('app_article_show', {id: article.id}) }}">
                                {{ article.title }}
                            </a>
                        </h3>
                        <p>{{ article.chapeau }}</p>

                        <p>
                            {{ article.author
                                ? article.author.pseudo
                                : 'Auteur supprimé'
                            }}
                        </p>

                        <p>
                            Publié le {{ article.createdAt|date('d/m/Y à H:i') }}
                        </p>

                        <p>
                            {{ article.comments|length }} commentaire(s) -
                            {{ article.likes|length }} J’aime
                        </p>
                        <a href="{{ path('app_article_show', {id: article.id}) }}">
                            Lire la suite
                        </a>
                    </article>
                {% else %}
                    <p>Aucune autre publication pour le moment.</p>
                {% endfor %}

                <a href="{{ path('app_article_index') }}">
                    Voir tous les articles
                </a>
            </section>
        {% else %}
            <p>Aucun article publié pour le moment.</p>
        {% endif %}
    </main>
{% endblock %}
