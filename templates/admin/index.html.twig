{% extends 'base.html.twig' %}

{% block title %}Espace administrateur - Bolonews{% endblock %}

{% block body %}
    <main>
        <header>
            <h1>Espace administrateur</h1>
            <p>
                Pilotez les publications et les accès de Bolonews.
            </p>
        </header>

        <nav aria-label="Gestion de l’administration">
            <ul>
                <li>
                    <a href="{{ path('app_admin_user_index') }}">
                        Gérer les utilisateurs
                    </a>
                </li>

                <li>
                    <a href="{{ path('app_admin_category_index') }}">
                        Gérer les catégories
                    </a>
                </li>
            </ul>
        </nav>

        <section aria-labelledby="admin-articles-title">
            <h2 id="admin-articles-title">
                Tous les articles
            </h2>

            {% for article in articles %}
                <article>
                    <img
                        src="{{ asset(
                            'images/articles/'
                            ~ article.imageFilename
                        ) }}"
                        alt="Illustration de l’article {{ article.title }}"
                    >

                    <p>{{ article.category.label }}</p>

                    <p>
                        {% if article.isPublished %}
                            Publié
                        {% else %}
                            Brouillon
                        {% endif %}
                    </p>

                    <h3>{{ article.title }}</h3>
                    <p>{{ article.chapeau }}</p>

                    <p>
                        Auteur :
                        {{ article.author
                            ? article.author.pseudo
                            : 'Auteur supprimé'
                        }}
                    </p>

                    <p>
                        Créé le
                        {{ article.createdAt|date('d/m/Y à H:i') }}

                        {% if article.updatedAt %}
                            - Mis à jour le
                            {{ article.updatedAt|date('d/m/Y à H:i') }}
                        {% endif %}
                    </p>

                    <p>
                        {{ article.comments|length }} commentaire(s) -
                        {{ article.likes|length }} J’aime
                    </p>

                    {% if article.isPublished %}
                        <a href="{{ path(
                            'app_article_show',
                            {id: article.id}
                        ) }}">
                            Voir l’article
                        </a>
                    {% endif %}

                    <a href="{{ path(
                        'app_article_edit',
                        {id: article.id}
                    ) }}">
                        Éditer
                    </a>

                    <details>
                        <summary>Supprimer</summary>

                        <p>
                            Supprimer définitivement l’article
                            « {{ article.title }} » ?
                        </p>

                        <p>Cette action est irréversible.</p>

                        <form
                            method="post"
                            action="{{ path(
                                'app_article_delete',
                                {id: article.id}
                            ) }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token(
                                    'delete-article' ~ article.id
                                ) }}"
                            >

                            <button type="submit">
                                Supprimer l’article
                            </button>
                        </form>
                    </details>
                </article>
            {% else %}
                <p>Aucun article enregistré.</p>
            {% endfor %}
        </section>
    </main>
{% endblock %}
